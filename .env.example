# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# NUNCA coloque o .env real no GitHub — ele já está no .gitignore.
#
# Onde encontrar esses valores:
# Supabase Dashboard -> seu projeto -> Project Settings -> API

# URL do seu projeto Supabase (ex: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" do Supabase (é segura para expor no frontend,
# o controle de acesso real é feito pelas regras RLS no banco)
VITE_SUPABASE_ANON_KEY=

# Nome do bucket de Storage usado para as imagens dos produtos
VITE_SUPABASE_STORAGE_BUCKET=produtos

# Número de WhatsApp da loja (com DDI+DDD, só números) usado no checkout
VITE_WHATSAPP_NUMBER=5511954196578
